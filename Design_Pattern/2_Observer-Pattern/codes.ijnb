    {
      "id": "c5b79dc3-3bfe-407d-90aa-d85c573584c3",
      "cell_type": "code",
      "source": "// build the weather station to test the implementation\npublic class WeatherStation {\n\n    public static void main (String[] args) {\n        WeatherData weatherData = new WeatherData(); // create WeatherData object\n\n        CurrentConditionDisplay currentDisplay = new CurrentConditionDisplay(weatherData); // create display element and register it\n        AvgMinMaxDisplay avgMinMaxDisplay = new AvgMinMaxDisplay(weatherData); // create another display element and register it\n        ForecastDisplay forecastDisplay = new ForecastDisplay(weatherData); // create another display element and register it\n\n\n        weatherData.setMeasurements(80, 65, 30.4f); \n        weatherData.setMeasurements(82, 70, 29.2f); \n        weatherData.setMeasurements(78, 90, 29.2f);\n    }\n}",
      "metadata": {
