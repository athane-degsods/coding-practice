    {
      "id": "daed9596-2e22-4a33-9048-aeba5cf47240",
      "cell_type": "code",
      "source": "// build display elements\npublic class CurrentConditionDisplay implements PushObserver, DisplayElement {\n    private float temperature;\n    private float humidity;\n    private Subject weatherData;\n\n    // constructor to register itself as an observer\n    public CurrentConditionDisplay(Subject weatherData) {\n        this.weatherData = weatherData;\n        weatherData.registerObserver(this);\n    }\n\n    // update method to receive new measurements and display them\n    @Override\n    public void update(float temperature, float humidity, float pressure) {\n        this.temperature = temperature;\n        this.humidity = humidity;\n        display();\n    }\n\n    @Override\n    public void update() {\n        // Base update method from Observer interface\n        display();\n    }\n\n    // display the current conditions\n    @Override\n    public void display() {\n        System.out.println(\"Current conditions: \" + temperature + \"F degrees and \" + humidity + \"% humidity\");\n    }\n}",
      "metadata": {
        "language": "java",
        "id": "daed9596-2e22-4a33-9048-aeba5cf47240",
        "executionSummary": {
          "executionOrder": 4,
