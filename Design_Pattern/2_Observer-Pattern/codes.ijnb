      "id": "a3e3baf3-fa77-4199-bf7e-dba01abcafb5",
      "cell_type": "markdown",
      "source": "# Observer Patterns\nThis is the implementation codes of the Observer Patterns in Java.",
      "metadata": {
        "language": "markdown",
        "id": "a3e3baf3-fa77-4199-bf7e-dba01abcafb5"
      }
    },
    {
      "id": "f4315f4d-3a29-48b0-a9ea-3149785ad343",
      "cell_type": "markdown",
      "source": "## 1. Weather application",
      "metadata": {
        "language": "markdown",
        "id": "f4315f4d-3a29-48b0-a9ea-3149785ad343"
      }
    },
    {
      "id": "cfe2ec7d-c86f-4d7d-a9b8-25539f371aa1",
      "cell_type": "code",
      "source": "// create Subject interface\npublic interface Subject {\n    void registerObserver(Observer o); // method to register an observer\n    void removeObserver(Observer o);   // method to remove an observer\n    void notifyObservers();            // method to notify all observers of a change\n}\n\n// create Observer interface\npublic interface Observer {\n    void update(); // base method to update observer\n}\n\n// create PushObserver and PullObserver interfaces that extend Observer\npublic interface PushObserver extends Observer {\n    void update(float temperature, float humidity, float pressure); // method to update observer with new measurements (push)\n}\n\npublic interface PullObserver extends Observer {\n    // uses the void update() method from Observer\n}\n\n// create DisplayElement interface for display elements\npublic interface DisplayElement {\n    void display(); // method to display the current conditions\n}",
      "metadata": {
        "language": "java",
        "id": "cfe2ec7d-c86f-4d7d-a9b8-25539f371aa1",
        "executionSummary": {
          "executionOrder": 1,
          "success": true
        }
      },
      "execution_count": 1,
      "outputs": [
        {
          "output_type": "execute_result",
          "data": {},
          "metadata": {},
          "execution_count": 1
        }
      ]
    },
    {
      "id": "f120286b-095f-4095-b728-f23834ab5870",
      "cell_type": "code",
      "source": "// create WeatherData class that implements Subject interface\npublic class WeatherData implements Subject {\n    private List<PushObserver> pushObservers; // list to hold all observers\n    private List<PullObserver> pullObservers; // list to hold all observers\n    private float temperature;\n    private float humidity;\n    private float pressure;\n\n    // constructor to initialize the observers list\n    public WeatherData() {\n        pushObservers = new ArrayList<PushObserver>();\n        pullObservers = new ArrayList<PullObserver>();\n    }\n\n    // register an observer to the list\n    @Override\n    public void registerObserver(Observer o) {\n        if (o instanceof PushObserver) {\n            pushObservers.add((PushObserver) o);\n        } else if (o instanceof PullObserver) {\n            pullObservers.add((PullObserver) o);\n        }\n    }\n\n    // remove an observer from the list\n    @Override\n    public void removeObserver(Observer o) {\n        pushObservers.remove(o);\n        pullObservers.remove(o);\n    }\n\n    // notify all observers of the current state\n    @Override\n    public void notifyObservers() {\n        for (PushObserver observer : pushObservers) {\n            observer.update(temperature, humidity, pressure);\n        }\n        for (PullObserver observer : pullObservers) {\n            observer.update();\n        }\n    }\n\n    // when measurements change, notify all observers\n    public void measurementsChanged() {\n        notifyObservers();\n    }\n\n    // set new measurements and trigger the change notification\n    public void setMeasurements(float temperature, float humidity, float pressure) {\n        this.temperature = temperature;\n        this.humidity = humidity;\n        this.pressure = pressure;\n        measurementsChanged();\n    }\n\n    // getter methods for the measurements\n    public float getTemperature() {\n        return temperature;\n    }\n\n    public float getHumidity() {\n        return humidity;\n    }\n\n    public float getPressure() {\n        return pressure;\n    }\n}",
      "metadata": {
        "language": "java",
        "id": "f120286b-095f-4095-b728-f23834ab5870",
        "executionSummary": {
          "executionOrder": 3,
          "success": true
        }
      },
