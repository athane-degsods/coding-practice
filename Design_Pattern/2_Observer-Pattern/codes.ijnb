    {
      "id": "5ac12041-f51d-45d2-bf2f-98b425bad33e",
      "cell_type": "code",
      "source": "\n\npublic class AvgMinMaxDisplay implements PullObserver, DisplayElement {\n        private WeatherData weatherData;\n        private List<Float> temperatureReadings;\n\n        public AvgMinMaxDisplay(Subject weatherData) {\n                this.weatherData = (WeatherData) weatherData;\n                this.temperatureReadings = new ArrayList<>();\n                weatherData.registerObserver(this);\n        }\n\n        public void update() {\n                temperatureReadings.add(weatherData.getTemperature());\n                display();\n        }\n\n        public void display() {\n                float maxTemp = Collections.max(temperatureReadings);\n                float minTemp = Collections.min(temperatureReadings);\n                float avgTemp = (float) temperatureReadings.stream().mapToDouble(Float::doubleValue).average().orElse(0.0f);\n                System.out.println(\"Avg/Max/Min temperature = \" + avgTemp + \"/\" + maxTemp + \"/\" + minTemp);\n        }\n}",
      "metadata": {
        "language": "java",
        "executionSummary": {
          "executionOrder": 9,
          "success": true
        }
      },
      "execution_count": 9,
      "outputs": [
