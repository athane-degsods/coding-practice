    {
      "id": "4e90eff1-ae63-4b86-9786-dc294253113d",
      "cell_type": "code",
      "source": "// using lambda expressions to simplify the code\nimport javax.swing.*;\nimport java.awt.event.ActionEvent;\nimport java.awt.event.ActionListener;\n\npublic class LambdaSwingObserverExample {\n    JFrame frame;\n\n    public static void main(String[] args) {\n        LambdaSwingObserverExample example = new LambdaSwingObserverExample();\n        example.go();\n    }\n\n    public void go() {\n        frame = new JFrame(\"Observer Swing Example\");\n\n        JButton decisionButton = new JButton(\"Should I do it?\");\n        decisionButton.addActionListener(e -> System.out.println(\"Don't do it, you might regret it!\"));\n        decisionButton.addActionListener(e -> System.out.println(\"Do it! Don't listen to the angel!\"));\n\n        JButton exitButton = new JButton(\"Exit\");\n        exitButton.addActionListener(e -> System.exit(0));\n\n        JPanel panel = new JPanel();\n        panel.add(decisionButton);\n        panel.add(exitButton);\n\n        frame.setDefaultCloseOperation(JFrame.EXIT_ON_CLOSE);\n        frame.getContentPane().add(panel);\n        frame.setSize(320, 200);\n        frame.setVisible(true);\n    }\n}",
      "metadata": {
        "language": "java",
        "executionSummary": {
          "executionOrder": 10,
