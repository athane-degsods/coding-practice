    {
      "id": "ff0377ff",
      "cell_type": "code",
      "source": "// Duck.java\n// public: accessible from anywhere\n// abstract: cannot be instantiated, must be subclassed\npublic abstract class Duck {\n\n    FlyBehavior flyBehavior;\n    QuackBehavior quackBehavior;\n\n\t// constructor: initializes the object\n    public Duck() {\n    }\n\n    public abstract void display ();\n\n    public void performFly() {\n        flyBehavior.fly();\n    }\n\n    public void performQuack() {\n        quackBehavior.quack();\n    }\n\n    public void swim() {\n        System.out.println(\"All ducks float, even decoys!\");\n    }\n\n    // dynamic behavior: allows changing the behavior at runtime\n    public void setFlyBehavior(FlyBehavior fb) {\n        flyBehavior = fb;   \n    }\n\n    public void setQuackBehavior(QuackBehavior qb) {\n        quackBehavior = qb;\n    }\n}",
      "metadata": {
        "language": "java",
        "id": "ff0377ff",
        "vscode": {
          "languageId": "java"
        },
        "executionSummary": {
          "executionOrder": 8,
          "success": true
        }
      },
      "execution_count": 8,
      "outputs": []
    },
    {
      "id": "41e0f2f2",
      "cell_type": "code",
      "source": "// MallardDuck.java\npublic class MallardDuck extends Duck {\n\n    public MallardDuck() {\n        flyBehavior = new FlyWithWings();\n        quackBehavior = new Quack();\n    }\n\n    public void display() {\n        System.out.println(\"I'm a real Mallard duck\");\n    }\n}\n// MallardDuck is a subclass of Duck that inherits the properties and behaviors of Duck",
      "metadata": {
        "language": "java",
        "id": "41e0f2f2",
        "executionSummary": {
          "executionOrder": 9,
          "success": true
        }
      },
