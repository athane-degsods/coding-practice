    {
      "id": "a2ed7087",
      "cell_type": "markdown",
      "source": "# Add dynamic behavior to the program",
      "metadata": {
        "language": "markdown",
        "id": "a2ed7087"
      }
    },
    {
      "id": "ca4dcd50-ef0b-41e4-926c-5f139fa686b4",
      "cell_type": "code",
      "source": "public class ModelDuck extends Duck {\n    public ModelDuck() {\n        flyBehavior = new FlyNoWay();\n        quackBehavior = new Quack();\n    }\n\n    public void display() {\n        System.out.println(\"I'm a model duck\");\n    }\n}",
      "metadata": {
        "language": "java",
        "id": "ca4dcd50-ef0b-41e4-926c-5f139fa686b4",
        "executionSummary": {
          "executionOrder": 12,
          "success": true
        }
      },
      "execution_count": 12,
      "outputs": []
    },
    {
      "id": "7fb4e08b-05bb-4ae1-8e2f-449f8af0a740",
      "cell_type": "code",
      "source": "public class FlyRocketPowered implements FlyBehavior {\n    public void fly() {\n        System.out.println(\"I'm flying with a rocket!\");    \n    }\n}",
      "metadata": {
        "language": "java",
        "id": "7fb4e08b-05bb-4ae1-8e2f-449f8af0a740",
        "executionSummary": {
          "executionOrder": 13,
          "success": true
        }
      },
      "execution_count": 13,
      "outputs": []
    },
    {
      "id": "eb0572ab-cb44-4d14-9072-d45ea6435433",
      "cell_type": "code",
      "source": "Duck model = new ModelDuck();\nmodel.performFly(); // the fly behavior is determined beforehand, and it won't change until we change it\nmodel.setFlyBehavior(new FlyRocketPowered()); // we can change the fly behavior at runtime by setting a new FlyBehavior\nmodel.performFly(); // the fly behavior has changed to FlyRocketPowered",
      "metadata": {
        "language": "java",
        "id": "eb0572ab-cb44-4d14-9072-d45ea6435433",
        "executionSummary": {
          "executionOrder": 14,
          "success": true
        }
      },
      "execution_count": 14,
      "outputs": [
        {
          "output_type": "execute_result",
          "data": {
            "text/plain": "I can't fly.\nI'm flying with a rocket!\n"
          },
          "metadata": {},
          "execution_count": 14
        }
      ]
