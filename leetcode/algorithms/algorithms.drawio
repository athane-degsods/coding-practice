        <mxCell id="Z1Le2mQN81I7Jfh_VKwA-84" value="parent node &amp;gt;= child node" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;" vertex="1" parent="Z1Le2mQN81I7Jfh_VKwA-12">
          <mxGeometry x="720" y="50" width="60" height="50" as="geometry" />
